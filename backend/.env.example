# Database configuration
DATABASE_URL="postgresql://flordemaio:flordemaio123@localhost:5532/flordemaio"

# Server configuration
PORT=3001

# Admin configuration (single-password admin auth - not used by the
# frontend in phase 1, but real security plumbing for a later phase)
ADMIN_PASSWORD=flordemaio2026

# Comma-separated list of allowed CORS origins (the frontend's URL(s))
CORS_ORIGINS=http://localhost:5001

# Per-user (member) auth configuration
# Secret used to sign member JWTs - MUST be overridden with a long random
# value in production.
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080

# Required for post/check-in photo uploads (Vercel Blob). Auto-injected by
# Vercel once a Blob store is connected to the project; for local Docker dev,
# leave empty and uploads fall back to local disk (backend/public/uploads).
BLOB_READ_WRITE_TOKEN=
